# Konfig fuer check_save_isolation.sh.
#
# <save> ... </save>           Eine Regex pro Zeile fuer die Funktionssignatur
#                              jedes Save-Pfads.
# <live> ... </live>           Eine Regex pro Zeile, die Live-State-Zugriffe
#                              identifiziert. Treffer im Save-Pfad = Verstoss.
# <snapshot_load> ... </>      Regex(en) fuer den erlaubten Snapshot-Load-
#                              Aufruf. Mehr als ein Treffer pro Save-Pfad =
#                              Race-Risiko.
#
# Die Regex laeuft mit egrep gegen Codezeilen.

<save>
^void[[:space:]]+Project::save\b
^void[[:space:]]+Project::saveCurrent\b
</save>

<live>
# Direkter Zugriff auf Live-Strukturen, der im Save-Pfad nichts zu suchen hat.
# Stand Phase 3: Snapshot ist eingefuehrt, save() liest nur noch via load().
# Diese Patterns wuerden direkten Zugriff auf den Live-State melden — z. B.
# wenn jemand `config->getConfig()` ODER `projectAudio.begin()` direkt im
# Save-Pfad aufruft.
\bconfig[[:space:]]*->[[:space:]]*getConfig\b
\bprojectAudio\b
</live>

<snapshot_load>
\bloadSnapshot[[:space:]]*\(
</snapshot_load>
